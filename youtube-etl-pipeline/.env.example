# =============================================================================
# YouTube ETL Pipeline — Environment Configuration
# =============================================================================
# IMPORTANT: Replace all placeholder values before running in production.
#            Never commit this file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# YouTube Data API v3
# -----------------------------------------------------------------------------
# Obtain your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Comma-separated list of YouTube Channel IDs to extract
# Example: UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
YOUTUBE_CHANNEL_IDS=UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=youtube_pipeline
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_secret_password

# External port mapping (host machine → container)
POSTGRES_EXTERNAL_PORT=5433

# -----------------------------------------------------------------------------
# Apache Airflow
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=YOUR_WEBSERVER__SECRET_KEY
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow_secret_password@postgres:5432/youtube_pipeline

# Default Airflow admin credentials (change in production!)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# -----------------------------------------------------------------------------
# Apache Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_YOUTUBE_RAW=youtube_raw_data

# -----------------------------------------------------------------------------
# Apache Spark
# -----------------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=4g

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
JUPYTER_TOKEN=your_jupyter_token_here
JUPYTER_ENABLE_LAB=yes
